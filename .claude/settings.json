{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "cache.nixos.org",
        "channels.nixos.org",
        "nixos.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "hex.pm",
        "*.hex.pm",
        "registry.npmjs.org",
        "mise.jdx.dev",
        "ollama.com",
        "registry.ollama.ai"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.local/share",
        "~/.local/state",
        "~/.mix",
        "~/.hex",
        "~/.bun",
        "~/.claude/projects/-home-andrew-projects-ficciones/memory"
      ]
    },
    "excludedCommands": [
      "nix"
    ]
  },
  "hooks": {
    "_comment": "Menard owns both of these \u2014 modules/menard/hooks/hooks.json is the plugin manifest. Wired here by path so the repo works without an install step; when menard ships as a plugin, enabling it replaces this block verbatim.",
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/modules/menard/hooks/menard-only.sh",
            "statusMessage": "menard guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/modules/menard/hooks/format-elixir.sh",
            "statusMessage": "mix format"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(mise tasks)",
      "Bash(mise tasks *)",
      "Bash(mise exec *)",
      "Bash(mise ls)",
      "Bash(mix *)",
      "Bash(sqlite3 *)",
      "Bash(bun *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(nix eval *)",
      "Bash(nix build *)",
      "Bash(nix flake check *)",
      "Bash(nix flake show *)"
    ]
  }
}
