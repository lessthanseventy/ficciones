#!/usr/bin/env bash
# Branch fencing (field survey §4 adopt #1, after Copilot's `copilot/*`-only rule): a pane the
# server spawned — TLON_THREAD in its env — may only commit on a `work/*` branch, the thread
# worktrees' branches (Server.Worktree.branch/1). Governance as a hook the coworker cannot
# talk its way past, not a request in a brief. A human terminal has no TLON_THREAD and is
# unaffected. Shared by every worktree through core.hooksPath.
set -u

# A commit touching what the manual is generated from must carry the regenerated pages. Without the
# tools (a coworker's PATH lacks mise) it stands aside and `mise run check` still catches the drift.
manual='^(tasks/|mise\.toml$|modules/desktop/hypr/hyprland\.lua$|modules/desktop/theme/palettes/|scripts/manual-gen\.sh$|docs/manual/(keys|tasks|palette)\.md$|modules/desktop/shell/assets/keys\.json$)'
if git diff --cached --name-only | grep -qE "$manual" &&
	command -v mise >/dev/null && command -v python3 >/dev/null && command -v nix >/dev/null; then
	# the check reads the working tree, so it only speaks for the commit when the two agree
	if unstaged="$(git diff --name-only | grep -E "$manual")"; then
		echo "pre-commit: the manual's sources have unstaged changes — stage or stash them first:" >&2
		echo "$unstaged" >&2
		exit 1
	fi
	scripts/manual-gen.sh --check || {
		echo "pre-commit: run mise run manual:gen and stage docs/manual" >&2
		exit 1
	}
fi

[ -n "${TLON_THREAD:-}" ] || exit 0
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
case "$branch" in
  work/*) exit 0 ;;
esac
echo "tlon: refusing to commit on '$branch' from thread #$TLON_THREAD — a coworker commits only on its work/<slug> branch (its worktree)." >&2
exit 1
