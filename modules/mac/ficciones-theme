#!/usr/bin/env bash
# The Mac's theme switch: what `astal-shell theme <name>` does on the Linux box, minus the desktop.
set -euo pipefail
dir="${XDG_CONFIG_HOME:-$HOME/.config}/ficciones"
next="${1:-}"
if [ -z "$next" ]; then
  echo "live: $(basename "$(readlink "$dir/theme")")"
  ls "$dir/themes"
  exit 0
fi
[ -d "$dir/themes/$next" ] || { echo "no palette '$next' in $dir/themes" >&2; exit 1; }

ln -sfn "themes/$next" "$dir/theme.next"
mv -fh "$dir/theme.next" "$dir/theme"

# Claude Code watches this file's contents, not the name in settings.json
mkdir -p "$HOME/.claude/themes"
cp -f "$dir/themes/$next/claude-theme.json" "$HOME/.claude/themes/ficciones.json"
chmod u+w "$HOME/.claude/themes/ficciones.json"

pkill -USR2 -x ghostty 2>/dev/null || true
ficciones-recolor || true
echo "live: $next"
