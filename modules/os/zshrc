# Claude Code project resume picker
function claude-resume() {
  local project=$(aichat search --json --global 2>/dev/null | jq -r '.cwd' | sort -u | fzf --prompt="Resume Claude project: " --height=40% --border)
  if [ -n "$project" ] && [ -d "$project" ]; then
    cd "$project" && aichat resume
  fi
}

# Claude Code project search
function claude-search() {
  local project=$(aichat search --json --global 2>/dev/null | jq -r '.cwd' | sort -u | fzf --prompt="Search Claude project: " --height=40% --border)
  if [ -n "$project" ] && [ -d "$project" ]; then
    cd "$project" && aichat search
  fi
}

