# Alt+m: fzf-pick a tmuxinator config and start it from the shell
_mux_picker() {
  local p
  p=$(tmuxinator list -n | tail -n +2 | fzf --prompt='mux> ' --height=40% --border --reverse) || { zle reset-prompt; return; }
  [[ -n $p ]] && BUFFER="tmuxinator start $p" && zle accept-line
}
zle -N _mux_picker
bindkey '^[m' _mux_picker

