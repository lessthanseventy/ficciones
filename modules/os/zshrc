    sudo true; \
    rate-mirrors --save=$TMPFILE arch --max-delay=21600 \
      && sudo mv /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-backup \
      && sudo mv $TMPFILE /etc/pacman.d/mirrorlist \
      && ua-drop-caches \
      && paru -Syyu --noconfirm'
# everything: Arch (paru), then the flake's pins (committed, flake.lock alone, when they moved) and
# the home-manager profile; the tlon server is left as it was (machine:update would restart it)
alias upall='ua-update-all \
  && mise --cd ~/projects/ficciones run flake:bump \
  && { git -C ~/projects/ficciones diff --quiet -- flake.lock \
       || git -C ~/projects/ficciones commit -q -m "flake: bump inputs (upall)" -- flake.lock; } \
  && mise --cd ~/projects/ficciones run home:switch \
  && mise --cd ~/projects/ficciones run shell:restart'

