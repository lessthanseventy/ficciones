# Replace some more things with better alternatives
# cat and ls: bat and eza at a terminal, the plain tools when the output is piped or captured, which
# is how agents (Claude Code) run them and what their parsing expects (`cat -v` is no bat flag)
unalias cat 2>/dev/null
function cat {
  if [[ -t 1 ]]; then
    bat --paging=never "$@"
  else
    command cat "$@"
  fi
}

# please is a "sudo !!" alias
