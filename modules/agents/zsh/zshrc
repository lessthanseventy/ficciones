# ~/.claude/zsh/.zshrc: a lean interactive rc for Claude Code's shells. Claude Code sources ~/.zshrc
# by path, not this file; ~/.zshrc's first lines hand over here when ZDOTDIR is ~/.claude/zsh.
#
# Claude Code snapshots an interactive zsh's functions, aliases, options and PATH (not other
# exports) and re-sources that snapshot on every Bash tool call. With ~/.zshrc it is ~14k lines
# (oh-my-zsh, starship, navi, fzf-tab...), none of which helps an agent. Env vars for its shells
# belong in settings.json's env (the no-editor/no-pager/no-prompt set lives there).

# --- toolchains ------------------------------------------------------------------------------------
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# --- PATH (same precedence as ~/.zshrc) ------------------------------------------------------------
typeset -U path
path=("$HOME/.local/share/pnpm" "$HOME/.bun/bin" "$HOME/.cargo/bin" "$HOME/.local/bin" $path)

# --- options ---------------------------------------------------------------------------------------
setopt INTERACTIVE_COMMENTS
