#!/usr/bin/env bash
# Play a stream in mpv, with a Referer when the host wants one.
#   mpv-stream <url> [referer]      the manifest (m3u8/mpd) or media URL
#   mpv-stream                      the clipboard: a URL, or a line "mpv-stream <url> [referer]"
#                                   (The Stream Detector's copy, with its command template set to
#                                   that) — Ctrl+Super+M plays what you just copied.
# mpv carries mpv-mpris, so the shell's now-playing (transport, position, title) is real here,
# unlike a streaming site's page player (2026-09-07).
set -euo pipefail
url="${1:-}"; ref="${2:-}"
if [ -z "$url" ]; then
    clip="$(wl-paste --no-newline 2>/dev/null || true)"
    clip="${clip#mpv-stream }"
    read -r url ref <<<"$clip"
fi
case "$url" in http://*|https://*) ;; *) notify-send -a mpv-stream -u critical "mpv-stream" "no URL: ${url:-empty clipboard}"; exit 1 ;; esac
args=(--force-window=yes --title="mpv · ${url##*/}")
[ -n "$ref" ] && args+=("--referrer=$ref" "--http-header-fields=Origin: ${ref%%/}")
notify-send -a mpv-stream "mpv" "${url:0:80}"
exec mpv "${args[@]}" "$url"
