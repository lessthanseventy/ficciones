#!/usr/bin/env bash
# sudo's askpass (SUDO_ASKPASS, set by home-manager): each keystroke echoes a random glyph from
# a randomly chosen theme, so the password's length and rhythm show but nothing else. With no
# terminal on stdin (hyprpm, a launcher, a background job) it reads from the controlling tty,
# and with no tty at all asks graphically — the read loop would otherwise wait forever.

themes=(
    "一 二 三 四 五 六 七 八 九 十 百 千 万 億"
    "🌑 🌒 🌓 🌔 🌕 🌖 🌗 🌘"
    "⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷ ⠿ ⡇ ⢸ ⣿"
    "░ ▒ ▓ █ ▚ ▞ ▙ ▟ ▛ ▜"
    "♈ ♉ ♊ ♋ ♌ ♍ ♎ ♏ ♐ ♑ ♒ ♓"
    "⚀ ⚁ ⚂ ⚃ ⚄ ⚅"
    "🀇 🀈 🀉 🀊 🀋 🀌 🀍 🀎 🀏 🀙 🀚 🀛"
    "α β γ δ ε ζ η θ ι κ λ μ ν ξ π ρ σ τ υ φ χ ψ ω"
    "ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ ᚷ ᚹ ᚺ ᚾ ᛁ ᛃ ᛇ ᛈ ᛉ ᛊ ᛏ ᛒ ᛖ ᛗ ᛚ ᛜ ᛞ ᛟ"
    "ℵ ℶ ℷ ℸ ∞ ∅ ∂ ∇ ∑ ∏ ∫ √ ≈ ≠ ≡ ∴ ∵"
    "☰ ☱ ☲ ☳ ☴ ☵ ☶ ☷"
    "♩ ♪ ♫ ♬ ♭ ♮ ♯ 𝄞 𝄢"
    "☀ ☁ ☂ ☃ ☄ ★ ☆ ☇ ☈ ☉ ☊ ☋ ☌ ☍"
    "♔ ♕ ♖ ♗ ♘ ♙ ♚ ♛ ♜ ♝ ♞ ♟"
    "🂡 🂢 🂣 🂤 🂥 🂦 🂧 🂨 🂩 🂪 🂫 🂭 🂮 🃁 🃂 🃃 🃄 🃅"
    "⠁ ⠃ ⠉ ⠙ ⠑ ⠋ ⠛ ⠓ ⠊ ⠚ ⠅ ⠇ ⠍ ⠝ ⠕ ⠏ ⠟ ⠗ ⠎ ⠞"
    "ꙮ ☯ ☸ ✡ ☥ ☦ ☧ ☨ ☩ ☪ ☫ ☬ ☭"
    "⌘ ⌥ ⌃ ⇧ ⏎ ⌫ ⇥ ⎋ ⌦ ⏏"
    "𓀀 𓁐 𓂀 𓃰 𓄿 𓆣 𓇋 𓈖 𓉐 𓊖 𓋴 𓌳 𓍢 𓎡 𓏏"
    "🜁 🜂 🜃 🜄 🜅 🜆 🜇 🜈 🜉 🜊 🜋 🜌 🜍 🜎 🜏 🜐 🜔 🜚 🜛"
    "🞄 🞅 🞆 🞇 🞈 🞉 🞊 🞋 🞌 🞍 🞎 🞏 🞐 🞑 🞒 🞓 🞔"
    "ᐁ ᐃ ᐅ ᐆ ᐊ ᐋ ᐯ ᐱ ᐳ ᐴ ᐸ ᐹ ᑌ ᑎ ᑐ ᑑ ᑕ ᑖ ᑫ ᑭ ᑯ ᑲ"
    "· ∘ ○ ◌ ◯ ◎ ◉ ● ◍ ◐ ◑ ◒ ◓"
)

# no terminal: the controlling tty if there is one, else a dialog
if [[ ! -t 0 ]]; then
    if [[ -r /dev/tty && -w /dev/tty ]] && exec 0</dev/tty 2>/dev/tty; then
        :
    else
        exec zenity --password --title="${1%: }" 2>/dev/null
    fi
fi

IFS=' ' read -ra chars <<< "${themes[$((RANDOM % ${#themes[@]}))]}"
prompt="${1:-Password: }"
printf '%s' "$prompt" >&2

password=""
shown=()   # the glyph echoed for each character, for erasing at its true width

while IFS= read -rs -n1 char; do
    if [[ -z "$char" ]]; then
        printf '\n' >&2
        break
    fi
    if [[ "$char" == $'\x7f' || "$char" == $'\b' ]]; then
        if [[ ${#password} -gt 0 ]]; then
            password="${password%?}"
            c="${shown[-1]}"; unset 'shown[-1]'
            w=$(printf '%s' "$c" | wc -L)
            printf '\e[%dD%*s\e[%dD' "$w" "$w" "" "$w" >&2
        fi
        continue
    fi
    password+="$char"
    c="${chars[$((RANDOM % ${#chars[@]}))]}"
    shown+=("$c")
    printf '%s' "$c" >&2
done

printf '%s' "$password"
