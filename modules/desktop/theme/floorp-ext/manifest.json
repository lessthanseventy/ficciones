{
  "manifest_version": 2,
  "name": "Ficciones",
  "version": "1.0",
  "description": "The machine's palette, live: the browser's own sheets and every other page.",
  "browser_specific_settings": { "gecko": { "id": "theme@ficciones" } },
  "permissions": ["<all_urls>", "storage"],
  "browser_action": {
    "default_title": "Ficciones",
    "default_popup": "popup.html",
    "default_area": "navbar"
  },
  "background": { "scripts": ["background.js"] },
  "experiment_apis": {
    "ficciones": {
      "schema": "schema.json",
      "parent": { "scopes": ["addon_parent"], "paths": [["ficciones"]], "script": "api.js" }
    }
  }
}
