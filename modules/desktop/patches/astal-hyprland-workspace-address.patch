+    // Hyprland 0.57 gives only a numbered workspace an `id`; a special or named one is known
+    // by its `address`, which is also what the socket events carry.
+    internal static int workspace_key(string? address) {
+        int n;
+        if (address == null || address == "") return 0;
+        if (int.try_parse(address, out n)) return n;
+        return -1337 - (int)(address.hash() % 1000000);
+    }
+
+    internal static int workspace_id(Json.Object obj) {
+        if (obj.has_member("id")) return (int)obj.get_int_member("id");
+        return workspace_key(obj.has_member("address") ? obj.get_string_member("address") : null);
+    }
