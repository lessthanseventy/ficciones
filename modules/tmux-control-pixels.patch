diff --git a/cmd-refresh-client.c b/cmd-refresh-client.c
index 11b43bf..7b8af24 100644
--- a/cmd-refresh-client.c
+++ b/cmd-refresh-client.c
@@ -65,7 +65,7 @@ cmd_refresh_client_control_client_size(struct cmd *self, struct cmdq_item *item)
 	struct args		*args = cmd_get_args(self);
 	struct client		*tc = cmdq_get_target_client(item);
 	const char		*size = args_get(args, 'C');
-	u_int			 w, x, y;
+	u_int			 w, x, y, xpixel = 0, ypixel = 0;
 
 	if (sscanf(size, "@%u:%ux%u", &w, &x, &y) == 3) {
 		if (x < WINDOW_MINIMUM || x > WINDOW_MAXIMUM ||
@@ -88,17 +88,20 @@ cmd_refresh_client_control_client_size(struct cmd *self, struct cmdq_item *item)
 		return (CMD_RETURN_NORMAL);
 	}
 
-	if (sscanf(size, "%u,%u", &x, &y) != 2 &&
-	    sscanf(size, "%ux%u", &x, &y) != 2) {
-		cmdq_error(item, "bad size argument");
-		return (CMD_RETURN_ERROR);
+	if (sscanf(size, "%ux%u,%ux%u", &x, &y, &xpixel, &ypixel) != 4) {
+		xpixel = ypixel = 0;
+		if (sscanf(size, "%u,%u", &x, &y) != 2 &&
+		    sscanf(size, "%ux%u", &x, &y) != 2) {
+			cmdq_error(item, "bad size argument");
+			return (CMD_RETURN_ERROR);
+		}
 	}
 	if (x < WINDOW_MINIMUM || x > WINDOW_MAXIMUM ||
 	    y < WINDOW_MINIMUM || y > WINDOW_MAXIMUM) {
 		cmdq_error(item, "size too small or too big");
 		return (CMD_RETURN_ERROR);
 	}
-	tty_set_size(&tc->tty, x, y, 0, 0);
+	tty_set_size(&tc->tty, x, y, xpixel, ypixel);
 	tc->flags |= CLIENT_SIZECHANGED;
 	recalculate_sizes_now(1);
 	return (CMD_RETURN_NORMAL);
